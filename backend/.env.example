# 运行环境与 HTTP
APP_ENV=production
# 仅在明文 HTTP 部署时设为 false；HTTPS 正式环境应设为 true。
SESSION_COOKIE_SECURE=false
# 同源部署无需配置 CORS；仅在前后端跨域时设置 CORS_ORIGINS。

# 阿里云 OSS
# 官网：https://www.aliyun.com/product/oss
# OSS 控制台：https://oss.console.aliyun.com/
# RAM 控制台：https://ram.console.aliyun.com/
# 官方配置文档：https://www.alibabacloud.com/help/zh/oss/developer-reference/use-the-accesskey-pair-of-a-ram-user-to-initiate-a-request
# 1. 开通 OSS，在控制台创建 Bucket，选择实际部署地域，读写权限设为“私有”。
# 2. 在 Bucket 概览中查看访问域名，将外网 Endpoint 填入 OSS_ENDPOINT：
#    例如 https://oss-cn-hangzhou.aliyuncs.com（按 Bucket 地域替换，不包含 Bucket 名）。
#    本项目也用此地址生成浏览器下载链接，因此应使用浏览器可访问的 HTTPS 外网地址。
# 3. OSS_BUCKET 填 Bucket 名称，不填 URL；OSS_PREFIX 是文件对象前缀，无须预先创建目录。
# 4. 在 RAM 控制台创建专用用户和 AccessKey，分别填入下方 ID、Secret，勿使用主账号密钥。
#    为该用户授权目标 Bucket 下 OSS_PREFIX/* 对象的 oss:GetObject、oss:PutObject、oss:DeleteObject 权限。
#    RAM 策略的资源格式：acs:oss:*:*:你的Bucket名称/coze/files/*（前缀须与 OSS_PREFIX 一致）。
# 5. OSS_SIGNED_URL_EXPIRES_SECONDS 是下载链接有效秒数，600 表示 10 分钟。
# 6. 将真实配置写入 backend/.env 并重启后端；不要将真实 AccessKey 写入本示例或提交到 Git。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_PREFIX=coze/files
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_EXPIRES_SECONDS=600

# 审核服务
AUDIT_SCRIPT_ENV_ALLOWLIST=
# 使用 cryptography.fernet.Fernet.generate_key() 生成，不能随意更换。
AUDIT_CONFIG_ENCRYPTION_KEY=

# 超级管理员：已有账号不重置密码；新账号必须填写 8–128 字符的初始 password。
SUPER_ADMINS='[{"name":"管理员姓名","account":"00001","password":"请替换为初始密码"}]'

# 阿里云号码认证（PNVS）：配套赠送签名与模板，密钥仅留在本地
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
