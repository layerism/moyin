{% set system_message -%}
{{ system }}

# 输出要求
- 仅返回符合下方 Schema 的结果 JSON，不附加其他内容。

# 输出 Schema
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "reason"
  ],
  "properties": {
    "passed": {
      "type": "boolean",
      "description": "是否通过审核。"
    },
    "reason": {
      "type": "string",
      "description": "审核原因。"
    }
  }
}
{%- endset %}
[
  {"role": "system", "content": {{ system_message | tojson }}},
  {"role": "user", "content": {{ user | tojson }}}
]
