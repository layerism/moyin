{% set system_message -%}
{{ system }}

# 输出要求
- 仅返回符合下方 Schema 的结果 JSON，不附加其他内容。

# 输出 Schema
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentScoringResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "reason"
  ],
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "评分结果。"
    },
    "reason": {
      "type": "string",
      "description": "完整的 Markdown 评分依据与扣分说明。"
    }
  }
}
{%- endset %}
[
  {"role": "system", "content": {{ system_message | tojson }}},
  {"role": "user", "content": {{ user | tojson }}}
]
