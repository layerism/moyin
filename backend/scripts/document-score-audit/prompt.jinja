{% set system_message -%}
{{ system }}

# 输出格式
仅返回符合以下 JSON Schema 的 JSON 对象，不附加 Markdown、解释或其他字段。
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentScoringResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "reason"
  ],
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "评分结果，范围为 0 到 100。"
    },
    "reason": {
      "type": "string",
      "description": "完整的 Markdown 评分依据与扣分说明。"
    }
  }
}
{%- endset %}
[
  {"role": "system", "content": {{ system_message | tojson }}},
  {"role": "user", "content": {{ user | tojson }}}
]
