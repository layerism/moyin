  "runtimeSettings": [
    {
      "key": "temperature",
      "label": "模型温度",
      "type": "number",
      "value": 0,
      "minimum": 0,
      "maximum": 1
    },
    {
      "key": "requestTimeoutSeconds",
      "label": "请求超时",
      "type": "number",
      "value": 60,
      "minimum": 5,
      "maximum": 300
    },
    {
      "key": "maximumInputCharacters",
      "label": "最大输入字符数",
      "type": "integer",
      "value": 220000,
