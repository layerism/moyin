+            ).fetchone()["count"]
+
+    return {
+        "currentVersionId": published["id"],
+        "currentVersionNo": published["version_no"],
+        "nextVersionNo": published["version_no"] + 1,
+        **impact,
+        "affectedStudentCount": affected_student_count,
