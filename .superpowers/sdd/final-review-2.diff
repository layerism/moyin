+    changed["nodes"].append(
+        {
+            "id": "review",
+            "kind": "form",
+            "title": "并发复核",
+            "requirement": "并发复核要求",
+            "infoFields": ["value"],
+            "autoApprove": True,
+        }
+    )
+    saved = client.put(f"/api/workflows/{flow_id}/draft", json={"config": changed})
+    assert saved.status_code == 200
+    expected_hash = client.post(f"/api/workflows/{flow_id}/revision-impact").json()[
+        "draftConfigHash"
+    ]
