+            for row in connection.execute(
+                """
+                SELECT token_value, flow_version_id FROM share_tokens
+                WHERE token_value IN (?, ?, ?)
+                """,
+                (original_token, valid_token, expired_token),
+            ).fetchall()
+        }
+        token_audits = connection.execute(
+            """
