 def _normalize_name(value: str) -> str:
     name = value.strip()
     if not name:
         raise AuditScriptValidationError("脚本名称不能为空")
     if len(name) > 120:
         raise AuditScriptValidationError("脚本名称不能超过 120 个字符")
     return name
 
 
+def _normalize_description(value: str) -> str:
+    description = value.strip()
+    if not description:
+        raise AuditScriptValidationError("脚本描述不能为空")
+    if len(description) > 500:
+        raise AuditScriptValidationError("脚本描述不能超过 500 个字符")
+    return description
+
+
 def _language_for_filename(filename: str) -> str:
     suffix = Path(filename).suffix.lower()
     if suffix == ".py":
         return "py"
     if suffix == ".js":
         return "js"
     raise AuditScriptValidationError("仅支持上传 .py 或 .js 脚本")
 
 
