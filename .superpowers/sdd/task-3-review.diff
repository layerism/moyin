+
+        connection.execute(
+            "UPDATE flow_instances SET flow_version_id = ? WHERE id = ?",
+            (new_version_id, instance["id"]),
+        )
+        if all(status == "approved" for status in statuses.values()):
+            connection.execute(
+                """
